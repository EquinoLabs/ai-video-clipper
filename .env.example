# ==============================================================================
# AI Video Clipper - Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or backend/.env and frontend/.env) and populate the values.
# NEVER commit real credentials, API keys, or private endpoints to source control.

# --- Application & Server Settings ---
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]
APP_SIGNING_SECRET=replace_with_a_secure_random_signing_secret_min_32_chars

# --- Database (Neon Postgres) ---
# Server-only. Used for metadata, jobs, stage runs, transcripts, and candidates.
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require

# --- Object Storage (Cloudflare R2) ---
# Server/worker only. Private bucket for source videos, rendered clips, captions, and thumbnails.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=ai-video-clipper-media-dev
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT_URL=https://<your_account_id>.r2.cloudflarestorage.com

# --- Media & Processing Limits ---
MAX_UPLOAD_BYTES=1073741824              # 1 GB
MAX_SOURCE_DURATION_SECONDS=7200         # 2 hours
TEMP_DISK_BUDGET_BYTES=21474836480       # 20 GB
JOB_TIMEOUT_SECONDS=3600                 # 1 hour
WORKER_CONCURRENCY=1
SOURCE_RETENTION_POLICY=retain_until_user_deletes_or_outputs_verified

# --- Clip Generation & Duration Rules ---
CLIP_MIN_SECONDS=10
CLIP_PREFERRED_MIN_SECONDS=15
CLIP_PREFERRED_MAX_SECONDS=45
CLIP_TARGET_SECONDS=30
CLIP_MAX_SECONDS=60
CANDIDATE_POOL_TARGET=10
CANDIDATE_DISPLAY_LIMIT=10

# --- Transcription (Whisper) ---
WHISPER_MODEL=base                       # local model: tiny, base, small, medium, large-v3

# --- LLM Provider & Evaluation ---
LLM_PROVIDER=openai                      # 'openai' or 'ollama'
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_llm_api_key_here
TRANSCRIPT_CHUNK_SIZE=2500               # words per chunk
TRANSCRIPT_CHUNK_OVERLAP_SECONDS=45.0
CANDIDATE_IOU_THRESHOLD=0.50

# --- Ollama Local LLM Settings ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=300.0

# --- Visual Framing (Phased) ---
VISUAL_FRAME_SAMPLE_INTERVAL_SECONDS=2.0

# --- Frontend Client Configuration ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
